    "/v1/skills/iflytek-voiceclone-tts/submit_training": {
      "post": {
        "description": "Submit only after sample_uploaded; query get_training until trained or failed. HTTP 200 is a task snapshot, not proof of completion. Save job_id and query at least 5 seconds apart with bounded polling. Inspect status, result and error_code; do not automatically resubmit submission_unknown. Reuse request_id and identical parameters when retrying the same operation.",
        "operationId": "iflytek_voiceclone_tts__submit_training",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job_TrainingResult_"
                }
