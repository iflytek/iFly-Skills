                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "security": [
          {
            "ServiceApiKey": []
          }
        ],
        "summary": "Submit a PDF for recognition",
        "tags": [
          "iflytek-pdf-image-ocr"
        ]
      }
    },
    "/v1/skills/iflytek-pdf-image-ocr/get_pdf_task": {
