{
  "components": {
    "schemas": {
      "Artifact": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "description": "Opaque backend artifact identifier.",
            "title": "Artifact Id",
            "type": "string"
          },
          "expires_at": {
            "description": "Expiration time in UTC, ISO 8601.",
            "title": "Expires At",
            "type": "string"
          },
          "mime_type": {
            "description": "Artifact media type.",
            "title": "Mime Type",
            "type": "string"
          },
          "size_bytes": {
            "description": "Artifact size in bytes.",
            "title": "Size Bytes",
            "type": "integer"
          },
          "url": {
            "description": "Expiring HTTPS download URL; anyone holding it can download until expiration.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "url",
          "mime_type",
          "size_bytes",
          "expires_at"
        ],
        "title": "Artifact",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "INVALID_REQUEST",
          "AUTHENTICATION_FAILED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "RATE_LIMITED",
          "UPSTREAM_PERMISSION_DENIED",
          "UPSTREAM_QUOTA_EXCEEDED",
          "UPSTREAM_ERROR",
          "UPSTREAM_PROTOCOL_ERROR",
          "DEPENDENCY_UNAVAILABLE",
          "TIMEOUT",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "trace_id"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "ImageOCR": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "default": "json,markdown",
            "description": "Requested OCR output representation.",
            "enum": [
              "json",
              "markdown",
              "json,markdown"
            ],
            "title": "Format",
            "type": "string"
          },
          "image_url": {
            "description": "Public HTTPS PNG or JPEG URL, up to 4 MiB; not a local path or Coze file_id.",
            "title": "Image Url",
            "type": "string"
          }
        },
        "required": [
          "image_url"
        ],
        "title": "ImageOCR",
        "type": "object"
      },
      "Job_PDFResult_": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "description": "Safe error category for failed or uncertain tasks, otherwise null.",
            "nullable": true,
            "title": "Error Code",
            "type": "string"
          },
          "job_id": {
            "description": "Backend job ID returned by this workspace's creation operation.",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Job Id",
            "type": "string"
          },
          "poll_after_seconds": {
            "default": 5,
            "description": "Minimum suggested interval before the next query; use bounded polling.",
            "title": "Poll After Seconds",
            "type": "integer"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PDFResult"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true,
                "type": "object"
              }
            ],
            "description": "Current stage details or final result; null before a result is available."
          },
          "status": {
            "description": "Task state; HTTP 200 alone does not mean completion. waiting_input needs an explicit stage action; do not blindly resubmit submission_unknown.",
            "enum": [
              "queued",
              "running",
              "waiting_input",
              "succeeded",
              "partially_succeeded",
              "failed",
              "submission_unknown"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status"
        ],
        "title": "Job[PDFResult]",
        "type": "object"
      },
      "OCRResult": {
        "additionalProperties": false,
        "properties": {
          "result": {
            "additionalProperties": true,
            "description": "Selected json and/or markdown entries from OCR.",
            "title": "Result",
            "type": "object"
          }
        },
        "required": [
          "result"
        ],
        "title": "OCRResult",
        "type": "object"
      },
      "PDFResult": {
        "additionalProperties": false,
        "properties": {
          "artifacts": {
            "description": "Available output files with expiring HTTPS URLs.",
            "items": {
              "$ref": "#/components/schemas/Artifact"
            },
            "title": "Artifacts",
            "type": "array"
          },
          "details": {
            "additionalProperties": true,
            "description": "Provider page-level results, including partial failures.",
            "title": "Details",
            "type": "object"
          },
          "upstream_status": {
            "description": "Provider task status for the current stage, when available.",
            "title": "Upstream Status",
            "type": "string"
          }
        },
        "required": [
          "upstream_status"
        ],
        "title": "PDFResult",
        "type": "object"
      },
      "PDFSubmission": {
        "additionalProperties": false,
        "properties": {
          "export_format": {
            "default": "word",
            "description": "Requested recognition export format.",
            "enum": [
              "word",
              "markdown",
              "json"
            ],
            "title": "Export Format",
            "type": "string"
          },
          "pdf_url": {
            "description": "Public HTTPS PDF URL, at most 32 MiB and 100 pages.",
            "title": "Pdf Url",
            "type": "string"
          },
          "request_id": {
            "description": "Stable idempotency key; reuse when retrying the same request.",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^\\S+$",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "pdf_url"
        ],
        "title": "PDFSubmission",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ServiceApiKey": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "iFly-Skills API plugin. Configure the deployment's X-API-Key separately; credentials are never tool arguments.",
    "title": "iflytek-pdf-image-ocr",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/skills/iflytek-pdf-image-ocr/create_pdf_task": {
      "post": {
        "description": "Accept a public HTTPS PDF up to 32 MiB and 100 pages. Query get_pdf_task for completion and output files. HTTP 200 is a task snapshot, not proof of completion. Save job_id and query at least 5 seconds apart with bounded polling. Inspect status, result and error_code; do not automatically resubmit submission_unknown. Reuse request_id and identical parameters when retrying the same operation.",
        "operationId": "iflytek_pdf_image_ocr__create_pdf_task",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PDFSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job_PDFResult_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
