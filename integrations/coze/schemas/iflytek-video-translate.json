        "description": "Confirm the existing transcript only after reviewing a waiting_input task; this operation does not edit subtitles. HTTP 200 is a task snapshot, not proof of completion. Save job_id and query at least 5 seconds apart with bounded polling. Inspect status, result and error_code; do not automatically resubmit submission_unknown. Reuse request_id and identical parameters when retrying the same operation.",
        "operationId": "iflytek_video_translate__confirm_transcript",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskAction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job_VideoResult_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
