{
  "components": {
    "schemas": {
      "Artifact": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "description": "Opaque backend artifact identifier.",
            "title": "Artifact Id",
            "type": "string"
          },
          "expires_at": {
            "description": "Expiration time in UTC, ISO 8601.",
            "title": "Expires At",
            "type": "string"
          },
          "mime_type": {
            "description": "Artifact media type.",
            "title": "Mime Type",
            "type": "string"
          },
          "size_bytes": {
            "description": "Artifact size in bytes.",
            "title": "Size Bytes",
            "type": "integer"
          },
          "url": {
            "description": "Expiring HTTPS download URL; anyone holding it can download until expiration.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "url",
          "mime_type",
          "size_bytes",
          "expires_at"
        ],
        "title": "Artifact",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "INVALID_REQUEST",
          "AUTHENTICATION_FAILED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "RATE_LIMITED",
          "UPSTREAM_PERMISSION_DENIED",
          "UPSTREAM_QUOTA_EXCEEDED",
          "UPSTREAM_ERROR",
          "UPSTREAM_PROTOCOL_ERROR",
          "DEPENDENCY_UNAVAILABLE",
          "TIMEOUT",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "trace_id"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "Job_RenderResult_": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "description": "Safe error category for failed or uncertain tasks, otherwise null.",
            "nullable": true,
            "title": "Error Code",
            "type": "string"
          },
          "job_id": {
            "description": "Backend job ID returned by this workspace's creation operation.",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Job Id",
            "type": "string"
          },
          "poll_after_seconds": {
            "default": 5,
            "description": "Minimum suggested interval before the next query; use bounded polling.",
            "title": "Poll After Seconds",
            "type": "integer"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RenderResult"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true,
                "type": "object"
              }
            ],
            "description": "Current stage details or final result; null before a result is available."
          },
          "status": {
            "description": "Task state; HTTP 200 alone does not mean completion. waiting_input needs an explicit stage action; do not blindly resubmit submission_unknown.",
            "enum": [
              "queued",
              "running",
              "waiting_input",
              "succeeded",
              "partially_succeeded",
              "failed",
              "submission_unknown"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status"
        ],
        "title": "Job[RenderResult]",
        "type": "object"
      },
      "Render": {
        "additionalProperties": false,
        "properties": {
          "fps": {
            "default": 25,
            "description": "Animation frames per second.",
            "maximum": 25.0,
            "minimum": 1.0,
            "title": "Fps",
            "type": "integer"
          },
          "height": {
            "default": 500,
            "description": "Viewport height in pixels before scale.",
            "maximum": 1200.0,
            "minimum": 64.0,
            "title": "Height",
            "type": "integer"
          },
          "html": {
            "description": "HTML/SVG/CSS animation, at most 256 KiB and 2000 elements; no scripts, external resources or local file references.",
            "maxLength": 262144,
            "minLength": 1,
            "title": "Html",
            "type": "string"
          },
          "loop_ms": {
            "default": 3000,
            "description": "Animation duration in milliseconds.",
            "maximum": 5000.0,
            "minimum": 100.0,
            "title": "Loop Ms",
            "type": "integer"
          },
          "request_id": {
            "description": "Stable idempotency key; reuse when retrying the same request.",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^\\S+$",
            "title": "Request Id",
            "type": "string"
          },
          "scale": {
            "default": 2,
            "description": "Resolution multiplier; frames times width times height times scale squared must not exceed 120 million.",
            "maximum": 2.0,
            "minimum": 1.0,
            "title": "Scale",
            "type": "integer"
          },
          "width": {
            "default": 800,
            "description": "Viewport width in pixels before scale.",
            "maximum": 1600.0,
            "minimum": 64.0,
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "request_id",
          "html"
        ],
        "title": "Render",
        "type": "object"
      },
      "RenderResult": {
        "additionalProperties": false,
        "properties": {
          "fps": {
            "description": "Animation frames per second.",
            "title": "Fps",
            "type": "integer"
          },
          "frames": {
            "description": "Rendered frame count.",
            "title": "Frames",
            "type": "integer"
          },
          "gif": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Artifact"
              }
            ],
            "description": "Rendered animated GIF with an expiring HTTPS URL."
          },
          "height": {
            "description": "Rendered GIF height in pixels.",
            "title": "Height",
            "type": "integer"
          },
          "width": {
            "description": "Rendered GIF width in pixels.",
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "gif",
          "width",
          "height",
          "frames",
          "fps"
        ],
        "title": "RenderResult",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ServiceApiKey": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "iFly-Skills API plugin. Configure the deployment's X-API-Key separately; credentials are never tool arguments.",
    "title": "animated-sketch-diagram",
