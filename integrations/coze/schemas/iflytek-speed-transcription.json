{
  "components": {
    "schemas": {
      "ErrorCode": {
        "enum": [
          "INVALID_REQUEST",
          "AUTHENTICATION_FAILED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "RATE_LIMITED",
          "UPSTREAM_PERMISSION_DENIED",
          "UPSTREAM_QUOTA_EXCEEDED",
          "UPSTREAM_ERROR",
          "UPSTREAM_PROTOCOL_ERROR",
          "DEPENDENCY_UNAVAILABLE",
          "TIMEOUT",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "trace_id"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "Job_TranscriptionResult_": {
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "description": "Safe error category for failed or uncertain tasks, otherwise null.",
            "nullable": true,
            "title": "Error Code",
            "type": "string"
          },
          "job_id": {
            "description": "Backend job ID returned by this workspace's creation operation.",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Job Id",
            "type": "string"
          },
          "poll_after_seconds": {
            "default": 5,
            "description": "Minimum suggested interval before the next query; use bounded polling.",
            "title": "Poll After Seconds",
            "type": "integer"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TranscriptionResult"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true,
                "type": "object"
              }
            ],
            "description": "Current stage details or final result; null before a result is available."
          },
          "status": {
            "description": "Task state; HTTP 200 alone does not mean completion. waiting_input needs an explicit stage action; do not blindly resubmit submission_unknown.",
            "enum": [
              "queued",
              "running",
              "waiting_input",
              "succeeded",
              "partially_succeeded",
              "failed",
              "submission_unknown"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status"
        ],
        "title": "Job[TranscriptionResult]",
        "type": "object"
      },
      "Segment": {
        "additionalProperties": false,
        "properties": {
          "begin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "description": "Provider segment start timestamp; units are not converted.",
            "title": "Begin"
          },
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "description": "Provider segment end timestamp; units are not converted.",
            "title": "End"
          },
          "speaker": {
            "description": "Provider speaker identifier.",
            "title": "Speaker",
            "type": "string"
          },
          "text": {
            "description": "Recognized segment text.",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "speaker",
          "begin",
          "end",
          "text"
        ],
        "title": "Segment",
        "type": "object"
      },
      "TranscriptionResult": {
        "additionalProperties": false,
        "properties": {
          "segments": {
            "description": "Provider timestamps, retained without unit conversion.",
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "title": "Segments",
            "type": "array"
          },
          "text": {
            "default": "",
            "description": "Full recognized text when available.",
            "title": "Text",
            "type": "string"
          },
          "upstream_status": {
            "description": "Provider task status for the current stage, when available.",
            "title": "Upstream Status",
            "type": "integer"
          }
        },
        "required": [
          "upstream_status"
        ],
        "title": "TranscriptionResult",
        "type": "object"
      },
      "TranscriptionSubmission": {
        "additionalProperties": false,
        "properties": {
          "accent": {
            "default": "mandarin",
            "description": "Required accent setting, including for English audio.",
            "enum": [
              "mandarin"
            ],
            "title": "Accent",
            "type": "string"
          },
          "audio_url": {
            "description": "Public HTTPS MP3 URL, up to 128 MiB.",
            "title": "Audio Url",
            "type": "string"
          },
          "domain": {
            "default": "pro_ost_ed",
            "description": "Required provider transcription task domain.",
            "enum": [
              "pro_ost_ed"
            ],
            "title": "Domain",
            "type": "string"
          },
          "language": {
            "default": "zh_cn",
            "description": "Fixed provider setting for automatic Chinese and English recognition.",
            "enum": [
              "zh_cn"
            ],
            "title": "Language",
            "type": "string"
          },
          "request_id": {
            "description": "Stable idempotency key; reuse when retrying the same request.",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^\\S+$",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "audio_url"
        ],
        "title": "TranscriptionSubmission",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ServiceApiKey": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "iFly-Skills API plugin. Configure the deployment's X-API-Key separately; credentials are never tool arguments.",
    "title": "iflytek-speed-transcription",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/skills/iflytek-speed-transcription/create_task": {
      "post": {
        "description": "Accept a public HTTPS MP3 up to 128 MiB. The fixed language settings automatically recognize Chinese and English; query get_task for the transcript. HTTP 200 is a task snapshot, not proof of completion. Save job_id and query at least 5 seconds apart with bounded polling. Inspect status, result and error_code; do not automatically resubmit submission_unknown. Reuse request_id and identical parameters when retrying the same operation.",
        "operationId": "iflytek_speed_transcription__create_task",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranscriptionSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job_TranscriptionResult_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "security": [
          {
            "ServiceApiKey": []
          }
        ],
        "summary": "Submit audio for transcription",
        "tags": [
          "iflytek-speed-transcription"
        ]
      }
    },
    "/v1/skills/iflytek-speed-transcription/get_task": {
      "get": {
        "description": "Return task state and the completed transcript with provider timestamps. HTTP 200 is a task snapshot, not proof of completion. Save job_id and query at least 5 seconds apart with bounded polling. Inspect status, result and error_code; do not automatically resubmit submission_unknown.",
        "operationId": "iflytek_speed_transcription__get_task",
        "parameters": [
          {
            "description": "Backend job ID returned by this workspace's creation operation.",
            "in": "query",
            "name": "job_id",
            "required": true,
            "schema": {
              "description": "Backend job ID returned by this workspace's creation operation.",
              "pattern": "^[a-f0-9]{32}$",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job_TranscriptionResult_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "security": [
          {
            "ServiceApiKey": []
          }
        ],
        "summary": "Query audio transcription",
        "tags": [
          "iflytek-speed-transcription"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "https://backend.example.com"
    }
  ]
}
