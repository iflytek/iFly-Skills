{
  "components": {
    "schemas": {
      "ErrorCode": {
        "enum": [
          "INVALID_REQUEST",
          "AUTHENTICATION_FAILED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "RATE_LIMITED",
          "UPSTREAM_PERMISSION_DENIED",
          "UPSTREAM_QUOTA_EXCEEDED",
          "UPSTREAM_ERROR",
          "UPSTREAM_PROTOCOL_ERROR",
          "DEPENDENCY_UNAVAILABLE",
          "TIMEOUT",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "trace_id"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "Proofread": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "description": "Chinese text to proofread; at most 220000 characters.",
            "maxLength": 220000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "Proofread",
        "type": "object"
      },
      "Proofreading": {
        "additionalProperties": false,
        "properties": {
          "checklist": {
            "description": "Provider suggestions, issue categories and offsets in the original text.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Checklist",
            "type": "array"
          }
        },
        "required": [
          "checklist"
        ],
        "title": "Proofreading",
        "type": "object"
      }
    },
    "securitySchemes": {
      "ServiceApiKey": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "iFly-Skills API plugin. Configure the deployment's X-API-Key separately; credentials are never tool arguments.",
    "title": "iflytek-text-proofread",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/skills/iflytek-text-proofread/check": {
      "post": {
        "description": "Return spelling and wording suggestions with provider offsets; does not modify the input.",
        "operationId": "iflytek_text_proofread__check",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Proofread"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proofreading"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "security": [
          {
            "ServiceApiKey": []
          }
        ],
        "summary": "Proofread Chinese text",
        "tags": [
          "iflytek-text-proofread"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "https://backend.example.com"
    }
  ]
}
