# Coze site configuration. Runtime: explicitly set COZE_ENV_FILE to this file's local copy.
# Copy to .env for local configuration; real values must not enter Git.
# From this directory: uv run --locked python -B scripts/check_config.py --site cn (or global).
# Explicitly select backend sites; preflight checks one site at a time. No cross-site fallback.

# Self-hosted deployment: select cn, global, or cn,global; configure enabled sites only.
# One workspace per enabled site. Platform tokens are not required to run the backend.
COZE_ENABLED_SITES=cn,global

# China: platform API credentials belong to the coze.cn account/workspace.
COZE_CN_API_BASE_URL=https://api.coze.cn
COZE_CN_WORKSPACE_ID=
COZE_CN_API_TOKEN=

# China: your deployment's HTTPS backend and its separate service credential.
COZE_CN_BACKEND_BASE_URL=
COZE_CN_BACKEND_API_KEY=
COZE_CN_ALLOWED_SKILLS=iflytek-translate,iflytek-text-proofread,iflytek-ocr-invoice,iflytek-hyper-tts,iflytek-pdf-image-ocr,iflytek-speed-transcription,iflytek-image-understanding,iflytek-video-translate,iflytek-voiceclone-tts,iflytek-contract-intelligence-review,animated-sketch-diagram

# Global: platform API credentials belong to the coze.com account/workspace.
COZE_GLOBAL_API_BASE_URL=https://api.coze.com
COZE_GLOBAL_WORKSPACE_ID=
COZE_GLOBAL_API_TOKEN=

# Global may use the same deployment URL; keep the workspace service credential separate.
COZE_GLOBAL_BACKEND_BASE_URL=
COZE_GLOBAL_BACKEND_API_KEY=
COZE_GLOBAL_ALLOWED_SKILLS=iflytek-translate,iflytek-text-proofread,iflytek-ocr-invoice,iflytek-hyper-tts,iflytek-pdf-image-ocr,iflytek-speed-transcription,iflytek-image-understanding,iflytek-video-translate,iflytek-voiceclone-tts,iflytek-contract-intelligence-review,animated-sketch-diagram

# Atomic Skill credentials. Enable each required service in the iFLYTEK console.
IFLY_APP_ID=
IFLY_API_KEY=
IFLY_API_SECRET=

# Contract workflow credentials: explicitly authorize image OCR, image understanding,
# translation and Spark v3.5/generalv3.5. No implicit fallback to the atomic triple.
IFLY_CONTRACT_APP_ID=
IFLY_CONTRACT_API_KEY=
IFLY_CONTRACT_API_SECRET=

# Deployment-owned private task/artifact directory; do not share across deployments.
# Blank defaults to this integration's output/runtime.
# Run one coordinator per directory; back it up and restrict filesystem access.
COZE_DATA_DIR=
# Your deployment's externally accessible HTTPS base URL, including any proxy prefix.
# Must route /v1/artifacts/... to this backend for Coze and upstream file retrieval.
# Required for audio, video, training samples, reports, PDF results and GIF output.
COZE_ARTIFACT_BASE_URL=

# Optional: immutable sha256:<64 lowercase hex> ID of the locally built render image.
# Leave blank until the container's rendering/isolation acceptance has passed.
COZE_RENDER_IMAGE=
