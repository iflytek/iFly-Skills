{
  "name": "n8n-nodes-iflytek",
  "version": "0.0.0-dev.0",
  "private": true,
  "description": "iFLYTEK skills for self-hosted n8n (development preview)",
  "license": "Apache-2.0",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "iflytek",
    "ifly-skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iflytek/iFly-Skills.git",
    "directory": "packages/n8n-nodes-iflytek"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "files": [
    "dist/credentials",
    "dist/nodes",
    "dist/shared",
    "runtime",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/stage-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/IflyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/IflyTranslate/IflyTranslate.node.js",
      "dist/nodes/IflyTextProofread/IflyTextProofread.node.js",
      "dist/nodes/IflyOcrInvoice/IflyOcrInvoice.node.js",
      "dist/nodes/IflyHyperTts/IflyHyperTts.node.js",
      "dist/nodes/IflyPdfImageOcr/IflyPdfImageOcr.node.js",
      "dist/nodes/IflySpeedTranscription/IflySpeedTranscription.node.js",
      "dist/nodes/IflyImageUnderstanding/IflyImageUnderstanding.node.js",
      "dist/nodes/IflyVideoTranslate/IflyVideoTranslate.node.js",
      "dist/nodes/IflyVoicecloneTts/IflyVoicecloneTts.node.js",
      "dist/nodes/IflyContractReview/IflyContractReview.node.js",
      "dist/nodes/IflyAnimatedSketch/IflyAnimatedSketch.node.js"
    ]
  },
  "dependencies": {
    "playwright-core": "1.61.1"
  },
  "peerDependencies": {
    "n8n-workflow": ">=2.39.3 <3"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "n8n-workflow": "2.39.3",
    "typescript": "5.9.3"
  }
}
